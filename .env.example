# =========================================================
# Aiven PostgreSQL & Django Configuration Environment Variables
# =========================================================

# Django Secret Key
DJANGO_SECRET_KEY=django-insecure-jeremy-bryan-villanueva-cinematic-portfolio-2026-key

# Debug Mode (set to False for production)
DEBUG=True

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*

# =========================================================
# Aiven Cloud PostgreSQL Database Credentials
# Obtain these from your Aiven Console (https://console.aiven.io):
# Project -> PostgreSQL Service -> Overview / Connection information
# =========================================================
DATABASE_NAME=defaultdb
DATABASE_USER=avnadmin
DATABASE_PASSWORD=your_aiven_password_here
DATABASE_HOST=your-aiven-pg-instance.aivencloud.com
DATABASE_PORT=18342
DATABASE_SSL_MODE=require

# =========================================================
# Frontend Vite Environment Variables
# =========================================================
VITE_API_URL=http://127.0.0.1:8000/api
